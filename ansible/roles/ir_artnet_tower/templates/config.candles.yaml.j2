# MANAGED BY ANSIBLE (role: ir_artnet_tower) — edit vars, not this file.
artnet:
  universe: {{ artnet_universe }}
  bind_ip: "0.0.0.0"
  short_name: "{{ tower_short_name }}"
  long_name: "{{ tower_long_name }}"

transmitter:
  backend: {{ transmit_backend }}
  lirc_device: {{ lirc_device }}
  gpio_pin: {{ ir_gpio_pin }}
  min_gap_ms: 60

ir_files:
  candles: "remotes/candles.ir"

# Held-look cues (rate): DMX value scales the retransmit rate so cast turning
# in place catch the IR as they come around. See DMX-CHART.md.
channels:
  - channel: 1            # ALL ON (On) — hold the look
    mode: rate
    command: "candles:On"
    floor: 8
    min_hz: 0.5
    max_hz: {{ candle_on_max_hz | default(6) }}
    curve: 2.0
    jitter_ms: {{ candle_jitter_ms | default(30) }}

  - channel: 2            # ALL OFF (Off) — hold during blackout
    mode: rate
    command: "candles:Off"
    priority: true        # blackout preempts queued ON/flicker pulses
    floor: 8
    min_hz: 0.5
    max_hz: {{ candle_on_max_hz | default(6) }}
    curve: 2.0
    jitter_ms: {{ candle_jitter_ms | default(30) }}

  - channel: 3            # CANDLE / flicker — hold
    mode: rate
    command: "candles:Candle"
    floor: 8
    min_hz: 0.5
    max_hz: 4
    curve: 2.0
    jitter_ms: {{ candle_jitter_ms | default(30) }}

  - channel: 4            # LIGHT / steady — hold
    mode: rate
    command: "candles:Light"
    floor: 8
    min_hz: 0.5
    max_hz: 4
    curve: 2.0
    jitter_ms: {{ candle_jitter_ms | default(30) }}

  - channel: 5            # BRIGHTEN (hold)
    mode: rate
    command: "candles:Brighten"
    floor: 1
    min_hz: 0
    max_hz: 5

  - channel: 6            # DIM (hold)
    mode: rate
    command: "candles:Dim"
    floor: 1
    min_hz: 0
    max_hz: 5

