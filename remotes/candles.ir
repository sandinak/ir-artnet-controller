Filetype: IR signals file
Version: 1
#
# PLACEHOLDER candle-remote codes. REPLACE these with your real Flipper capture:
#   Flipper -> Infrared -> Learn New Remote -> press each candle-remote button
#   -> name it EXACTLY as below (ON, OFF, DIM_UP, ...) -> Save.
#   Copy the resulting .ir here (keep the signal names so config.candles.yaml matches).
# If Flipper can't decode a button, capture it as RAW -- it still transmits.
#
name: ON
type: parsed
protocol: NEC
address: 00 00 00 00
command: 01 00 00 00
#
name: OFF
type: parsed
protocol: NEC
address: 00 00 00 00
command: 02 00 00 00
#
