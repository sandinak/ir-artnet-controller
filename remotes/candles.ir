type: parsed
protocol: NEC
address: 00 00 00 00
command: 03 00 00 00
#
name: DIM_DOWN
type: parsed
protocol: NEC
address: 00 00 00 00
command: 04 00 00 00
#
name: FLICKER
type: parsed
protocol: NEC
address: 00 00 00 00
command: 05 00 00 00
#
name: STEADY
type: parsed
protocol: NEC
address: 00 00 00 00
command: 06 00 00 00
